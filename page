<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Дом.ру Пэй: первая оплата (демо)</title>
<style>
:root{--bg:#eef0f4;--card:#fff;--ink:#1e2433;--mut:#71788e;--line:#dfe3e8;--soft:#f0f2f5;--navy:#2a334e;--navyink:#fff;--red:#e42313;--or:#f25822;--ok:#059669;--okbg:#ecfdf5;--warn:#fff4e5;--warnink:#8a4b00}
:root:not([data-theme="light"]){color-scheme:light dark}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1118;--card:#181d2a;--ink:#eef0f6;--mut:#9aa3b8;--line:#2a3147;--soft:#232a3d;--navy:#4a5d96;--navyink:#fff;--okbg:#10291f;--warn:#33270f;--warnink:#f0c27a}}
:root[data-theme="dark"]{--bg:#0e1118;--card:#181d2a;--ink:#eef0f6;--mut:#9aa3b8;--line:#2a3147;--soft:#232a3d;--navy:#4a5d96;--navyink:#fff;--okbg:#10291f;--warn:#33270f;--warnink:#f0c27a;color-scheme:dark}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.4 -apple-system,BlinkMacSystemFont,"SF Pro Text",Inter,Roboto,Arial,sans-serif}
button,input{font:inherit;color:inherit}
.demo{max-width:420px;margin:0 auto;padding:12px 12px 4px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.demo b{font-size:12px;color:var(--mut);font-weight:500;width:100%}
.demo button{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:5px 10px;font-size:12px;cursor:pointer}
.demo button.on{background:var(--navy);color:var(--navyink);border-color:var(--navy)}
.phone{max-width:420px;margin:8px auto 24px;background:var(--card);border-radius:28px;border:1px solid var(--line);overflow:hidden;min-height:760px;display:flex;flex-direction:column}
@media (max-width:440px){.phone{margin:0;border-radius:0;border:0;min-height:100vh}}
header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 10px}
header h1{font-size:16px;margin:0;font-weight:600}
.ib{width:36px;height:36px;border-radius:50%;border:0;background:var(--soft);cursor:pointer;display:grid;place-items:center}
.ib[disabled]{visibility:hidden}
.scr{padding:4px 16px 20px;flex:1;display:flex;flex-direction:column;gap:14px}
.scr[hidden]{display:none}#br{display:none}.scr.br>:not(#br){display:none!important}.scr.br>#br{display:block}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px}
.promo{background:linear-gradient(90deg,#f4f6f9,#e3e8f2);color:#1e2433;border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:10px;border:0}
.promo p{margin:0;font-weight:500;max-width:70%}
.btn{border:0;background:var(--navy);color:var(--navyink);border-radius:12px;height:48px;font-weight:600;font-size:15px;cursor:pointer;width:100%}
.btn[disabled]{opacity:.4;cursor:not-allowed}
.btn.sm{height:34px;width:auto;padding:0 16px;font-size:13px;border-radius:999px}
.btn2{border:0;background:transparent;color:var(--mut);height:40px;cursor:pointer;width:100%}
h2{font-size:17px;margin:0}
.mut{color:var(--mut);font-size:12px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.opt{position:relative;border:1px solid var(--line);border-radius:16px;padding:12px;height:104px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;background:var(--card);text-align:left}
.opt.on{border:2px solid var(--navy);padding:11px}
.opt .r{display:flex;align-items:center;gap:6px;border-top:1px solid var(--line);padding-top:8px;font-size:12px;font-weight:600}
.dot{width:16px;height:16px;border-radius:50%;border:1.5px solid var(--mut);display:inline-grid;place-items:center}
.opt.on .dot{border-color:var(--navy)}.opt.on .dot::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--navy)}
.badge{position:absolute;top:-9px;right:8px;background:var(--or);color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:999px}
.inp{width:100%;height:46px;border:1px solid var(--line);border-radius:12px;padding:0 14px;background:var(--card);font-size:15px;font-weight:600}
.inp:focus,.otp input:focus{outline:2px solid var(--navy);outline-offset:0}
.lbl{display:block;font-size:12px;color:var(--mut);margin:0 0 6px}
.pill{display:inline-flex;gap:6px;align-items:center;background:var(--soft);border-radius:999px;padding:4px 10px;font-size:11px}
.pill::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ok)}
.otp{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.otp input{min-width:0;width:100%;height:54px;text-align:center;font-size:22px;font-weight:700;border:1px solid var(--line);border-radius:12px;background:var(--soft)}
.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--soft);border-radius:12px;padding:3px}
.seg button{border:0;background:transparent;border-radius:10px;height:34px;cursor:pointer;font-weight:500}
.seg button.on{background:var(--card);font-weight:600;box-shadow:0 0 0 1px var(--line)}.seg.c3{grid-template-columns:repeat(3,minmax(0,1fr))}.seg.c3 button{height:auto;min-height:40px;padding:4px;font-size:12px;line-height:1.2}
.cb{display:flex;align-items:center;gap:12px;background:var(--okbg);border-radius:14px;padding:12px}
.cb i{font-style:normal;width:38px;height:38px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px;flex:none}
.info{background:var(--soft);border-radius:12px;padding:10px 12px;font-size:12px}
.warn{background:var(--warn);color:var(--warnink);border-radius:12px;padding:10px 12px;font-size:12px}
.row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--line)}
.row:last-child{border:0}.row span:first-child{color:var(--mut)}.row span:last-child{text-align:right;font-weight:600}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:5px 12px;font-size:13px;cursor:pointer}
.chip.on{background:var(--navy);color:var(--navyink);border-color:var(--navy)}
.tg{display:flex;gap:12px;align-items:flex-start;justify-content:space-between}
.sw{flex:none;width:44px;height:26px;border-radius:13px;border:0;background:var(--line);position:relative;cursor:pointer}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .15s}
.sw[aria-checked="true"]{background:var(--ok)}.sw[aria-checked="true"]::after{transform:translateX(18px)}
.ok{width:72px;height:72px;border-radius:50%;background:var(--okbg);color:var(--ok);display:grid;place-items:center;font-size:36px;margin:8px auto}
.spin{width:44px;height:44px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--navy);margin:14px auto;animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spin{animation-duration:3s}}
.center{text-align:center}.sp{flex:1}
.toast{position:absolute;left:50%;transform:translateX(-50%);bottom:90px;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:12px;font-size:12px;max-width:320px;text-align:center}
.phone{position:relative}
a.l{color:var(--mut);font-size:12px;text-decoration:underline;cursor:pointer;background:none;border:0;padding:0}
</style></head>
<body>
<div class="demo"><b>Демо: нажмите на шаг, чтобы перейти к нему</b><span id="nav"></span></div>
<div class="phone">
<header><button class="ib" id="back" aria-label="Назад">‹</button>
<h1 id="ttl">Оплата услуг</h1>
<img src="data:image/png;base64," alt="Дом.ру" style="display:block;height:22px;width:auto"></header>

<section class="scr" id="s1">
<div id="promo" class="card promo"><p><b style="font-size:17px">Верните до 10% с оплаты интернета</b><br>Подключите Дом.ру Пэй за минуту и платите без ввода данных</p><button class="btn sm" id="pr" style="width:max-content">Получить кешбэк</button></div>
<h2 id="mth">Способы оплаты</h2>
<div class="grid2" id="mg">
<button class="opt" data-m="sbp"><b style="font-size:15px">СБП</b><span class="r"><i class="dot"></i>Из приложения банка</span></button>
<button class="opt on" data-m="pay"><span class="badge">до 10% кешбэк</span><b style="font-size:14px">Дом.ру Пэй</b><span class="r" style="color:var(--or)"><i class="dot"></i>до 10% кешбэк</span></button>
</div>
<div id="amw"><label class="lbl" for="amt">Сумма пополнения</label><input class="inp" id="amt" inputmode="decimal" value="1149.16"></div>
<div class="sp"></div>
<button class="btn" id="b1"></button>
<div class="mut center">Защищённый платёж с гарантией безопасности данных</div><div class="card"><div class="lbl">Сценарий демо</div><div class="seg" id="sc"><button class="on" data-sc="first">Первая оплата</button><button data-sc="repeat">Повторная оплата</button></div><div class="mut" id="sch" style="margin-top:8px"></div></div>
</section>

<section class="scr" id="s2" hidden>
<div class="card center"><h2>Подтверждение номера</h2><p class="mut" style="margin:6px 0 10px">Войдите в Дом.ру Пэй, чтобы оплачивать интернет в один клик и получать кешбэк бонусами</p><span class="pill">Договор № 4120 8921 54</span></div>
<div class="card"><div class="row"><span>Номер телефона</span><span>+7 (921) 845-12-90</span></div>
<label class="lbl" style="margin-top:8px">Код подтверждения из SMS</label>
<div class="otp" id="otp"><input maxlength="1" inputmode="numeric" aria-label="Цифра 1"><input maxlength="1" inputmode="numeric" aria-label="Цифра 2"><input maxlength="1" inputmode="numeric" aria-label="Цифра 3"><input maxlength="1" inputmode="numeric" aria-label="Цифра 4"></div>
<div style="display:flex;justify-content:space-between;margin-top:10px"><span class="mut">Повторно через <b id="tm">00:42</b></span><button class="l a" id="fill" style="font-size:12px;text-decoration:underline;background:none;border:0;color:var(--mut);cursor:pointer">Подставить код из демо</button></div></div>

<div class="sp"></div>
<button class="btn" id="b2" disabled>Подтвердить номер</button>
</section>

<section class="scr" id="s3" hidden>
<div class="cb"><i id="cbp">+5%</i><div><b>+<span class="cbv"></span> бонусов кешбэка</b><div class="mut">Вернутся на бонусный счёт сразу после оплаты</div></div></div>
<div class="info">Счёт откроется в банке-партнёре Урал-ФД автоматически. Лимиты зависят от уровня идентификации.</div>
<div class="seg" id="seg"><button class="on" data-s="sbp">СБП из банка</button><button data-s="card">Карта (по желанию)</button></div>
<div id="pc" class="card" style="display:grid;gap:10px">
<input class="inp" id="cn" inputmode="numeric" placeholder="0000 0000 0000 0000" aria-label="Номер карты">
<div class="grid2"><input class="inp" id="ce" inputmode="numeric" placeholder="ММ / ГГ" aria-label="Срок действия"><input class="inp" id="cv" inputmode="numeric" maxlength="3" placeholder="CVC" type="password" aria-label="CVC"></div>
<div class="mut">Карта сохранится в защищённом профиле. Следующие платежи пройдут без ввода данных. <button class="l" id="tc" style="font-size:12px;text-decoration:underline;background:none;border:0;color:var(--mut);cursor:pointer">Подставить тестовую карту</button></div></div>
<div id="ps" class="card" style="display:none"><div class="mut" style="margin-bottom:8px">Выберите банк, откуда переведём деньги на ваш счёт Дом.ру Пэй. Перевод нужно один раз подтвердить в приложении банка</div><div class="chips" id="bk"><button class="chip">Т-Банк</button><button class="chip">Сбер</button><button class="chip">ВТБ</button><button class="chip">Альфа-Банк</button><button class="chip">Другой банк</button></div><div class="mut" style="margin-top:10px">Если банк поддерживает подписку СБП, дальше счёт можно пополнять автоматически и без переходов</div></div>
<div class="card"><div class="tg"><div><b>Автоплатёж</b><div class="mut" id="aptx"></div></div><button class="sw" id="sap" role="switch" aria-label="Автоплатёж" aria-checked="false"></button></div></div><label style="display:flex;gap:10px;align-items:flex-start;font-size:12px;color:var(--mut)"><input type="checkbox" id="tr" checked>Согласен с условиями Дом.ру Пэй, обработкой данных и правилами бонусной программы</label>
<div class="sp"></div>
<button class="btn" id="b3" disabled></button><div id="br"><div id="b0s" class="card center" style="display:none"><div class="spin"></div><div><b>Открываем приложение </b><b id="bn0"></b></div><div class="mut">После подтверждения вы вернётесь в Дом.ру Пэй</div></div><div id="bhd" style="background:#3a3f4b;color:#fff;border-radius:16px 16px 0 0;padding:14px 16px;display:flex;justify-content:space-between;align-items:center"><b id="bn2"></b><span style="font-size:12px;opacity:.8">Приложение банка</span></div><div id="bcd" class="card" style="border-radius:0 0 16px 16px;border-top:0"><div id="b1s"><h2 id="bt">Перевод по СБП</h2><div style="margin:8px 0 12px"><div class="row"><span>Получатель</span><span>Дом.ру Пэй, Урал-ФД</span></div><div class="row"><span>Сумма</span><span><span id="ba"></span> ₽</span></div><div class="row"><span>Комиссия</span><span>0 ₽</span></div><div class="row"><span>Списать со счёта</span><span>Основной •• 3047</span></div><div class="row" id="bsub" style="display:none"><span>Подписка СБП</span><span>Для автоплатежа Дом.ру</span></div></div><button class="btn" id="bok">Подтвердить перевод</button><button class="btn2" id="bno">Отменить</button></div><div id="b2s" class="center" style="display:none"><div class="ok">✓</div><h2>Перевод выполнен</h2><p class="mut" style="margin:6px 0 12px">Деньги поступят на счёт Дом.ру Пэй в течение нескольких секунд</p><button class="btn" id="bback">Вернуться в Дом.ру Пэй</button></div></div></div>
</section>

<section class="scr" id="s4" hidden>
<h2>Подтверждение платежа</h2>
<div class="card" id="sum"></div>
<div id="cf" class="card"><label class="lbl">Код из SMS, отправленного на +7 (921) •••-••-90</label><div class="otp" id="otp4"><input maxlength="1" inputmode="numeric" aria-label="Цифра 1"><input maxlength="1" inputmode="numeric" aria-label="Цифра 2"><input maxlength="1" inputmode="numeric" aria-label="Цифра 3"><input maxlength="1" inputmode="numeric" aria-label="Цифра 4"></div><div style="margin:10px 0 12px"><button id="fill4" style="font-size:12px;text-decoration:underline;background:none;border:0;color:var(--mut);cursor:pointer;padding:0">Подставить код из демо</button></div><button class="btn" id="b4a" disabled>Подтвердить и оплатить</button></div>
<div id="pg" class="card center" style="display:none"><div class="spin"></div><b>Проводим платёж</b><div class="mut">Это займёт несколько секунд</div></div>
<div id="dn" class="card center" style="display:none"><div class="ok">✓</div><h2 id="dt">Платёж прошёл</h2><div class="mut" style="margin:4px 0 12px" id="rc"></div><div class="info" id="ap2" style="margin-bottom:12px"></div><button class="btn" id="b4">Вернуться на страницу оплаты</button></div>
</section>

<div class="toast" id="tt" hidden></div>
</div>
<script>
var N=['Оплата','Номер','Подключение','Подтверждение'],T=['Оплата услуг','Подтверждение номера','Подключение','Подтверждение платежа'];
var S,cur=1,$=function(i){return document.getElementById(i)};
function init(){var p=(S&&S.sc)||'first';S={sc:p,amt:1149.16,m:'pay',src:'sbp',bank:'',ap:false,at:false,th:1000,tu:2000,last:''};['cn','ce','cv'].forEach(function(i){$(i).value=''});document.querySelectorAll('#otp input').forEach(function(e){e.value=''});$('amt').value='1149.16';$('tr').checked=true;pick('pay');seg('sbp');scn(p);go(1)}
function f(n){return n.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2})}
function r0(n){return n.toLocaleString('ru-RU')}
function toast(t){var e=$('tt');e.textContent=t;e.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(function(){e.hidden=true},3200)}
function go(n){cur=n;$('s3').classList.remove('br');for(var i=1;i<=4;i++)$('s'+i).hidden=i!==n;$('ttl').textContent=T[n-1];$('back').disabled=n===1||n===6;
$('nav').innerHTML=N.map(function(t,i){return '<button class="'+(i+1===n?'on':'')+'" data-g="'+(i+1)+'">'+(i+1)+'. '+t+'</button>'}).join('');
cbu();
$('b1').textContent=S.sc==='auto'?'Показать автосписание':'Оплатить '+f(S.amt)+' ₽';$('b3').textContent='Подключить и оплатить '+f(S.amt)+' ₽';
if(n===2)tick();if(n===4)conf();chk3();window.scrollTo(0,0)}
function pick(m){S.m=m;document.querySelectorAll('.opt').forEach(function(e){e.classList.toggle('on',e.dataset.m===m)})}
function seg(s){S.src=s;document.querySelectorAll('#seg button').forEach(function(e){e.classList.toggle('on',e.dataset.s===s)});$('pc').style.display=s==='card'?'grid':'none';$('ps').style.display=s==='sbp'?'block':'none';chk3();cbu()}
function chk3(){var ok=$('tr').checked&&(S.src==='card'?($('cn').value.replace(/\D/g,'').length===16&&$('ce').value.replace(/\D/g,'').length===4&&$('cv').value.length===3):!!S.bank);$('b3').disabled=!ok}
var tmr;function tick(){clearInterval(tmr);var t=42;$('tm').textContent='00:42';tmr=setInterval(function(){t--;$('tm').textContent='00:'+(t<10?'0':'')+Math.max(t,0);if(t<=0)clearInterval(tmr)},1000)}
function src(){return S.src==='card'?'Карта •• '+(S.last||'4242'):'СБП · '+S.bank+(S.sc!=='first'?' (подписка)':'')}
function rt(){return S.ap?.1:.05}
function cbu(){var r=rt();document.querySelectorAll('.cbv').forEach(function(e){e.textContent=f(S.amt*r)});$('cbp').textContent='+'+(S.ap?10:5)+'%';$('sap').setAttribute('aria-checked',S.ap);$('aptx').textContent=(S.ap?'Кешбэк 10% включён. ':'Включите автоплатёж: кешбэк 10% вместо 5%. ')+(S.src==='sbp'?'Согласие на подписку СБП даётся в приложении банка вместе с переводом, отдельный шаг не нужен':'Следующие платежи спишем с карты автоматически')}
function scn(v){S.sc=v;document.querySelectorAll('#sc button').forEach(function(e){e.classList.toggle('on',e.dataset.sc===v)});$('sch').textContent={first:'Новый клиент: номер, подключение, перевод в банке, платёж без SMS',repeat:'Клиент уже подключён: шаги 2 и 3 пропускаются, платёж подтверждается SMS'}[v];$('promo').style.display=v==='first'?'':'none';$('b1').textContent='Оплатить '+f(S.amt)+' ₽';S.ap=false;S.at=false;if(v!=='first'){S.src='sbp';S.bank=S.bank||'Сбер'}}
